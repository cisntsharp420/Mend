# Copy to .env (never commit .env) or export in your shell.
# Only needed for live LLM runs; baselines and replay mode work without it.
ANTHROPIC_API_KEY=
# Or, for the OpenAI backend (--agent llm_openai / make llm-dev AGENT=llm_openai):
# OPENAI_API_KEY=
# RECOVERY_OPENAI_MODEL=gpt-5.5
# RECOVERY_OPENAI_PRICES=in,out,cached   # USD per 1M tokens, for cost reporting
# Optional overrides
# RECOVERY_MODEL=claude-opus-5-5
# IMAGE_REGISTRY=mirror.gcr.io/library
